<?xml version="1.0" encoding="UTF-8"?>

<widget
  id="org.negin.aac"
  version="1.0.0"
  xmlns="http://www.w3.org/ns/widgets"
  xmlns:cdv="http://cordova.apache.org/ns/1.0">

  <name>نگین AAC</name>

  <description>
    سامانه ارتباط جایگزین و افزوده نگین
  </description>

  <author email="qaishaidari.smart@gmail.com">
    Qais Haidari
  </author>

  <content src="index.html" />

  <access origin="*" />

  <allow-navigation href="*" />

  <preference
    name="Orientation"
    value="portrait"
  />

  <preference
    name="Fullscreen"
    value="false"
  />

  <preference
    name="DisallowOverscroll"
    value="true"
  />

  <preference
    name="AndroidInsecureFileModeEnabled"
    value="true"
  />

  <platform name="android">

    <preference
      name="android-minSdkVersion"
      value="24"
    />

    <preference
      name="android-targetSdkVersion"
      value="36"
    />

    <preference
      name="android-compileSdkVersion"
      value="36"
    />

  </platform>

</widget>
